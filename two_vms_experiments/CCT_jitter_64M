#!/bin/bash

BASE_DELAY=10
JITTERS=(0 1 2 3 4 5 6)
RESULTS_FILE="./results/$(basename "${BASH_SOURCE[0]}").csv"

trap 'tc qdisc del dev eth0 root 2>/dev/null; true' EXIT INT TERM
tc qdisc del dev eth0 root 2>/dev/null; true

echo "jitter_ms,time_us" > $RESULTS_FILE

for jitter in "${JITTERS[@]}"; do
    echo "Running with base delay ${BASE_DELAY}ms + jitter ${jitter}ms"

    if [ $jitter -gt 0 ]; then
        tc qdisc add dev eth0 root netem delay ${BASE_DELAY}ms ${jitter}ms
    else
        tc qdisc add dev eth0 root netem delay ${BASE_DELAY}ms
    fi

    TIME=$(mpirun --allow-run-as-root -np 2 \
      -H 65.108.32.131:1,65.108.32.146:1 \
      --mca btl_tcp_if_include eth0 \
      --mca oob_tcp_if_include eth0 \
      /root/nccl-tests/build/all_reduce_perf -b 64M -e 64M -f 2 2>/dev/null \
      | grep "67108864" | grep -v "^#" | awk '{print $6}')

    echo "${jitter},${TIME}" >> $RESULTS_FILE
    echo "Jitter ${jitter}ms -> time ${TIME}us"

    tc qdisc del dev eth0 root
done

echo "Results saved to $RESULTS_FILE"
